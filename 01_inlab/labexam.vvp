v0x5fa2b7afe2a0_0 .net "lt", 0 0, L_0x5fa2b7afec90;  alias, 1 drivers
    .scope S_0x5fa2b7ae9120;
T_0 ;
    %vpi_call 2 16 "$monitor", "At time %0t: a = %b, b = %b -> eq = %b, gt = %b, lt = %b", $time, v0x5fa2b7afe400_0, v0x5fa2b7afe4c0_0, v0x5fa2b7afe560_0, v0x5fa2b7afe660_0, v0x5fa2b7afe730_0 {0 0 0};
    %end;
